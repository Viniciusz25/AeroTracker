# =============================================================================
# AeroTracker Core — Template de Variáveis de Ambiente
# Copie este arquivo para .env e preencha com suas chaves reais.
# NUNCA faça commit do arquivo .env com chaves reais.
# =============================================================================

# --- Configuração Geral ------------------------------------------------------
APP_NAME=AeroTracker Core
APP_ENV=development          # development | production
DEBUG=true
LOG_LEVEL=DEBUG              # DEBUG | INFO | WARNING | ERROR

# --- Localização Padrão (latitude/longitude) ---------------------------------
DEFAULT_LATITUDE=-23.5505
DEFAULT_LONGITUDE=-46.6333
DEFAULT_TIMEZONE=America/Sao_Paulo
DEFAULT_LOCATION_NAME=São Paulo

# --- Aeronaves ---------------------------------------------------------------
# OpenSky Network (opcional — sem chave tem limite de 400 req/dia)
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# ADS-B Exchange (requer chave)
ADSBEXCHANGE_API_KEY=

# FlightAware (estrutura preparada — requer chave paga)
FLIGHTAWARE_API_KEY=

# FlightRadar24 (estrutura preparada — requer chave)
FLIGHTRADAR24_API_KEY=

# --- Clima -------------------------------------------------------------------
OPENWEATHER_API_KEY=your_openweather_key_here
# Open-Meteo não requer chave de API

# --- Espaço / NASA -----------------------------------------------------------
NASA_API_KEY=your_nasa_key_here
# SpaceX API (público — sem chave)
# Launch Library 2 (público — sem chave)
# ISS Tracker (público — sem chave)

# N2YO (requer chave)
N2YO_API_KEY=

# --- Cache -------------------------------------------------------------------
CACHE_DIR=./cache_data       # Diretório para cache persistido
CACHE_TTL_AIRCRAFT=30        # segundos
CACHE_TTL_WEATHER=300        # segundos (5 min)
CACHE_TTL_ISS=5              # segundos
CACHE_TTL_LAUNCH=600         # segundos (10 min)
CACHE_TTL_MOON=3600          # segundos (1 hora)

# --- Storage -----------------------------------------------------------------
STORAGE_DIR=./storage_data   # Diretório para dados históricos

# --- Scheduler ---------------------------------------------------------------
SCHEDULER_TIMEZONE=America/Sao_Paulo

# --- Display -----------------------------------------------------------------
DISPLAY_THEME=dark            # dark | light
DISPLAY_LANGUAGE=pt_BR        # pt_BR | en_US
WINDOW_WIDTH=1400
WINDOW_HEIGHT=900
